# SQL Online Judge docker-compose 环境变量示例
# 复制为 .env 后按需修改（compose 会自动加载）：
#   copy .env.example .env      # Windows
#   cp .env.example .env        # Linux / macOS
# 未设置的项将使用 docker-compose.yml 中的默认值。

# ---- 业务数据库（MySQL）----
MYSQL_DATABASE=sql_oj_db
# root 账号密码（同时作为后端连接 MySQL 的密码）
MYSQL_ROOT_PASSWORD=sql_oj

# ---- 判题数据库（PostgreSQL）----
JUDGE_DB_NAME=judge_db
JUDGE_DB_USER=judge_user
JUDGE_DB_PASSWORD=judge_pass

# ---- 后端（可选）----
# 生产环境务必替换为随机密钥
# DJANGO_SECRET_KEY=change-me-in-production
# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=*
