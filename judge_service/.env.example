# SQL 判题服务配置文件（示例）
#
# 使用方法：复制本文件为 judge_service/.env 后按需修改。
#   copy .env.example .env      # Windows
#   cp .env.example .env        # Linux / macOS
#
# docker compose 会自动读取 judge_service/.env（见 docker-compose.yml），
# 因此容器与判题服务共用同一套配置，无需重复填写。
#
# 优先级：真实环境变量 > .env 配置文件 > 代码内置默认值。

# ---- 判题数据库连接（与 docker-compose.yml 的 JUDGE_DB_* 对应）----
JUDGE_DB_HOST=127.0.0.1
JUDGE_DB_PORT=5433
JUDGE_DB_NAME=judge_db
JUDGE_DB_USER=judge_user
JUDGE_DB_PASSWORD=judge_pass

# ---- 连接池与就绪等待 ----
# 启动时等待数据库可连接的最长秒数
JUDGE_DB_READY_TIMEOUT=60
# 每次连接尝试的超时（秒）
JUDGE_DB_CONNECT_TIMEOUT=2
# 连接池最大连接数（决定并发承载上限）
JUDGE_DB_POOL_MAX=20
# 常驻（预热）连接数：建议与最大连接数一致，避免高并发下反复建连
JUDGE_DB_POOL_MIN=20
# 单个请求内测试用例的并行度（>1 时并行执行）
JUDGE_CASE_CONCURRENCY=4
# 连接池耗尽时等待空闲连接的最长秒数，超时后返回服务繁忙
JUDGE_POOL_ACQUIRE_TIMEOUT=10

# ---- 服务间鉴权 ----
# 后端 / judge-worker 调用 /judge、/introspect、/pool 时携带的共享令牌。
# 必须与根目录 .env 中的 JUDGE_SERVICE_TOKEN 保持一致；留空则判题接口不校验（仅限本地调试）。
JUDGE_SERVICE_TOKEN=change-me-in-production
